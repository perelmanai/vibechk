{
  "name": "vibechk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/vibechk",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/vibechk && npm run build --workspace=server",
    "test": "npm run test --workspace=packages/vibechk",
    "test:run": "npm run test:run --workspace=packages/vibechk",
    "typecheck": "npm run typecheck --workspace=packages/vibechk",
    "server": "npm run start --workspace=server"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
