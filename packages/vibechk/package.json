{
  "name": "vibechk",
  "version": "0.1.0",
  "description": "Daily streak tracker for vibe coders — tracks your AI-assisted coding sessions and lets you compare streaks with friends",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vibechk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "streak",
    "coding",
    "vibe-coding",
    "claude-code",
    "productivity",
    "habit",
    "tracker",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "boxen": "^7.1.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dayjs": "^1.11.13",
    "inquirer": "^10.2.2",
    "open": "^10.1.0",
    "ora": "^6.3.1",
    "proper-lockfile": "^4.1.2",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
